# Public Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Only Supabase Configuration (Required for /api/v1/ingest and /api/v1/heartbeat)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Simulator Script Defaults (Optional)
SIMULATOR_API_URL=http://localhost:3000
SIMULATOR_DEVICE_ID=00000000-0000-4000-8000-000000000001
SIMULATOR_WEBHOOK_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
